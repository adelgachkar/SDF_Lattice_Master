{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SDF-Lattice Graph",
  "type": "object",
  "required": [
    "nodes",
    "edges"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/edge"
      }
    }
  },
  "definitions": {
    "node": {
      "type": "object",
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "params": {
          "type": "object"
        }
      }
    },
    "edge": {
      "type": "object",
      "required": [
        "source",
        "source_port",
        "target",
        "target_port"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "source_port": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "target_port": {
          "type": "string"
        }
      }
    }
  }
}
